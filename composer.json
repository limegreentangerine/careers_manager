{
	"name": "limegreentangerine/careers_manager",
	"description": "Careers Management System",
	"type": "concrete5-package",
	"license": "proprietary",
	"minimum-stability": "stable",
	"autoload": {
		"psr-4": {
			"CareersManager\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"CareersManager\\Tests\\": "tests/"
		}
	},
	"authors": [],
	"require": {
		"limegreentangerine/class_kit": "^1.0 || ^2.0",
		"limegreentangerine/mapbox_kit": "^1.0"
	},
	"require-dev": {
		"php": "^8.4",
		"phpunit/phpunit": "^11",
		"concrete5/core": "^9.2",
		"friendsofphp/php-cs-fixer": "^3.95",
		"phpstan/phpstan": "^2.2"
	},
	"config": {
		"allow-plugins": {
			"mlocati/composer-patcher": true
		},
		"policy": {
			"advisories": {
				"ignore-id": ["PKSA-nktx-f1n1-b4yd", "PKSA-xz3r-9gp4-4m1z", "PKSA-v5yj-8nmz-sk2q", "PKSA-ft77-7h5f-p3r6", "PKSA-b14r-zh1d-vdrc", "PKSA-w9tt-7782-78jx", "PKSA-pwh8-d4fr-nywn"]
			}
		}
	},
	"scripts": {
		"typecheck": "./vendor/bin/phpstan analyse -c phpstan.neon --error-format=table || true",
		"test": "php -d error_reporting=\"E_ALL & ~E_DEPRECATED\" vendor/bin/phpunit",
		"test-coverage": "php -d error_reporting=\"E_ALL & ~E_DEPRECATED\" vendor/bin/phpunit --coverage-text",
		"format:php": "php-cs-fixer fix",
		"format:php:check": "php-cs-fixer check --diff",
		"format:js": "npx prettier --write .",
		"format:js:check": "npx prettier --check .",
		"format": [
			"@format:php",
			"@format:js"
		],
		"format:check": [
			"@format:php:check",
			"@format:js:check"
		],
		"post-install-cmd": [
			"npm install"
		]
	}
}
